
RewriteEngine On

# Redirect old profile URLs to the introduction on the homepage.
RewriteCond %{QUERY_STRING} ^(.+)$
RewriteRule ^profile/?$ /?%1#profile [R=301,L,NE]
RewriteRule ^profile/?$ /#profile [R=301,L,NE]

# Redirect explicit index files without affecting Apache's directory index lookup.
RewriteCond %{THE_REQUEST} \s/+[^?\s]*index\.html[?\s]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^((?:[^/]+/)?)index\.html$ /$1 [R=301,L]

# BEGIN InfinityFree Managed Code
# DO NOT EDIT - MANAGED BY THE MEMBERS AREA
ErrorDocument 400 /err/400.html
ErrorDocument 401 /err/401.html
ErrorDocument 403 /err/403.html
ErrorDocument 404 /err/404.html
ErrorDocument 500 /err/500.html
ErrorDocument 503 /err/503.html
# END InfinityFree Managed Code
